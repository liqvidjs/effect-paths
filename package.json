{
  "name": "effect-paths",
  "version": "0.0.2",
  "description": "Effect helpers adding type safety for dealing with absolute vs relative and file vs directory",
  "homepage": "https://github.com/liqvidjs/effect-paths/tree/main#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/effect-paths/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/effect-paths.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./vanilla": {
      "@liqvid/dev": "./src/vanilla.ts",
      "types": "./dist/types/vanilla.d.ts",
      "import": "./dist/esm/vanilla.js"
    }
  },
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "find ./dist -name tsconfig.tsbuildinfo -delete",
    "build": "pnpm build:js && pnpm build:dts",
    "build:dts": "pnpm build:dts:copy && pnpm build:dts:rm",
    "build:dts:copy": "cp src/*.d.ts dist/types",
    "build:dts:rm": "sed -i '' -E '/import .*\\.d\\.ts.*;$/d' dist/esm/index.js",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "build:js": "tsc",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "test": "tsc --noEmit --project tests",
    "watch": "tsc --watch",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@effect/tsgo": "0.39.0",
    "@types/node": "^26.4.1",
    "effect": "^4.0.0-rc.110",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
